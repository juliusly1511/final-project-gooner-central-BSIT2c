<%- include('partials/header', { title: 'Sign Up' }) %>

<div class="form-card">
  <h1>Create your JobConnect account</h1>
  <% if (error) { %><div class="error"><%= error %></div><% } %>

  <% if (googleEnabled) { %>
    <a href="/auth/google" class="btn btn-google" style="display:flex;align-items:center;justify-content:center;gap:8px;width:100%;">
      <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.6 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3 0 5.7 1.1 7.8 3l5.7-5.7C33.9 6.5 29.2 4.5 24 4.5 12.7 4.5 3.5 13.7 3.5 25S12.7 45.5 24 45.5 44.5 36.3 44.5 25c0-1.5-.2-3-.4-4.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 16 19 13 24 13c3 0 5.7 1.1 7.8 3l5.7-5.7C33.9 6.5 29.2 4.5 24 4.5 16 4.5 9.2 9 6.3 14.7z"/><path fill="#4CAF50" d="M24 45.5c5.1 0 9.7-1.9 13.2-5.1l-6.1-5c-2 1.4-4.5 2.2-7.1 2.2-5.3 0-9.7-3.4-11.3-8.1l-6.5 5C9.1 41 16 45.5 24 45.5z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.2-4.2 5.4l6.1 5C40.9 36 44.5 30 44.5 25c0-1.5-.2-3-.4-4.5z"/></svg>
      Sign up with Google
    </a>
    <div style="text-align:center;margin:14px 0;color:var(--muted);font-size:13px;">— or —</div>
  <% } %>

  <form action="/auth/register" method="POST" id="registerForm">
    <div class="form-group">
      <label>I am a...</label>
      <div class="role-toggle">
        <label>
          <input type="radio" name="role" value="seeker" id="role-seeker" <%= form.role !== 'employer' ? 'checked' : '' %> />
          <span>Job Seeker</span>
        </label>
        <label>
          <input type="radio" name="role" value="employer" id="role-employer" <%= form.role === 'employer' ? 'checked' : '' %> />
          <span>Employer</span>
        </label>
      </div>
    </div>

    <div class="form-group">
      <label>Full name</label>
      <input name="name" value="<%= form.name || '' %>" required />
    </div>
    <div class="form-group">
      <label>Email</label>
      <input name="email" type="email" value="<%= form.email || '' %>" required />
    </div>
    <div class="form-group">
      <label>Location (city, country)</label>
      <input name="location" value="<%= form.location || '' %>" />
    </div>

    <!-- Seeker-only fields -->
    <div id="seekerFields">
      <div class="form-group">
        <label>Professional headline</label>
        <input name="headline" value="<%= form.headline || '' %>" placeholder="e.g. Senior React Developer" />
      </div>
      <div class="form-group">
        <label>Top skills (comma-separated)</label>
        <input name="skills" value="<%= form.skills || '' %>" placeholder="React, Node.js, SQL" />
      </div>
    </div>

    <!-- Employer-only fields -->
    <div id="employerFields" style="display:none;">
      <div class="form-group">
        <label>Company name</label>
        <input name="company" value="<%= form.company || '' %>" />
      </div>
      <div class="form-group">
        <label>Industry</label>
        <input name="industry" value="<%= form.industry || '' %>" placeholder="e.g. Software, Retail" />
      </div>
      <div class="form-group">
        <label>Company size</label>
        <select name="companySize">
          <option value="">Select…</option>
          <% ['1-10','11-50','51-200','201-500','501-1000','1000+'].forEach(s => { %>
            <option value="<%= s %>" <%= form.companySize === s ? 'selected' : '' %>><%= s %> employees</option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="form-group">
      <label>Password (min 8 chars)</label>
      <input id="pw" name="password" type="password" minlength="8" required />
      <div class="strength">
        <div class="strength-bar"><div id="pwBar"></div></div>
        <div id="pwLabel" class="strength-label">Strength: —</div>
      </div>
    </div>
    <div class="form-group">
      <label>Confirm password</label>
      <input id="pw2" name="confirmPassword" type="password" minlength="8" required />
      <div id="pwMatch" class="strength-label"></div>
    </div>

    <button class="btn" type="submit" style="width:100%;">Create account</button>
  </form>
  <p style="text-align:center;margin-top:16px;font-size:14px;">
    Already have an account? <a href="/auth/login">Sign in</a>
  </p>
  <p style="text-align:center;margin-top:8px;font-size:13px;color:var(--muted);">
    We'll email you a 6-digit code to verify.
  </p>
</div>

<script src="/js/password.js"></script>
<script>
  // Toggle seeker vs employer fields
  function syncRoleFields() {
    var isEmp = document.getElementById('role-employer').checked;
    document.getElementById('seekerFields').style.display = isEmp ? 'none' : '';
    document.getElementById('employerFields').style.display = isEmp ? '' : 'none';
  }
  document.getElementById('role-seeker').addEventListener('change', syncRoleFields);
  document.getElementById('role-employer').addEventListener('change', syncRoleFields);
  syncRoleFields();
</script>

<%- include('partials/footer') %>
