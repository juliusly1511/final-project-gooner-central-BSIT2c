<%- include('partials/header', { title: 'Sign In' }) %>

<div class="form-card">
  <h1>Sign in</h1>
  <% if (error) { %><div class="error"><%= error %></div><% } %>

  <% if (googleEnabled) { %>
    <a href="/auth/google" class="btn btn-google" style="display:flex;align-items:center;justify-content:center;gap:8px;width:100%;">
      <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.6 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3 0 5.7 1.1 7.8 3l5.7-5.7C33.9 6.5 29.2 4.5 24 4.5 12.7 4.5 3.5 13.7 3.5 25S12.7 45.5 24 45.5 44.5 36.3 44.5 25c0-1.5-.2-3-.4-4.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 16 19 13 24 13c3 0 5.7 1.1 7.8 3l5.7-5.7C33.9 6.5 29.2 4.5 24 4.5 16 4.5 9.2 9 6.3 14.7z"/><path fill="#4CAF50" d="M24 45.5c5.1 0 9.7-1.9 13.2-5.1l-6.1-5c-2 1.4-4.5 2.2-7.1 2.2-5.3 0-9.7-3.4-11.3-8.1l-6.5 5C9.1 41 16 45.5 24 45.5z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.2-4.2 5.4l6.1 5C40.9 36 44.5 30 44.5 25c0-1.5-.2-3-.4-4.5z"/></svg>
      Continue with Google
    </a>
    <div style="text-align:center;margin:14px 0;color:var(--muted);font-size:13px;">— or —</div>
  <% } %>

  <form action="/auth/login" method="POST">
    <div class="form-group">
      <label>Email</label>
      <input name="email" type="email" value="<%= form.email || '' %>" required />
    </div>
    <div class="form-group">
      <label>Password</label>
      <input name="password" type="password" required />
    </div>
    <button class="btn" type="submit" style="width:100%;">Sign in</button>
  </form>

  <p style="text-align:center;margin-top:12px;font-size:14px;">
    <a href="/auth/forgot">Forgot password?</a>
  </p>
  <div style="text-align:center;margin:8px 0;color:var(--muted);font-size:13px;">— or —</div>
  <a href="/auth/login-code" class="btn btn-outline" style="display:block;text-align:center;">
    Email me a sign-in code
  </a>
  <p style="text-align:center;margin-top:16px;font-size:14px;">
    No account? <a href="/auth/register">Create one</a>
  </p>
</div>

<%- include('partials/footer') %>
