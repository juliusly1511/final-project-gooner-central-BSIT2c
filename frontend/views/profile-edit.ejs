<%- include('partials/header', { title: 'My Profile' }) %>

<div class="container" style="max-width:820px;">
  <div class="profile-header">
    <div class="avatar-wrap">
      <% if (user.avatarUrl) { %>
        <img src="<%= user.avatarUrl %>" alt="avatar" class="avatar-lg" />
      <% } else { %>
        <div class="avatar-lg avatar-placeholder"><%= (user.name||'?').charAt(0).toUpperCase() %></div>
      <% } %>
    </div>
    <div>
      <h1 style="margin:0;"><%= user.name %></h1>
      <div style="color:var(--muted);">
        <%= user.role === 'employer' ? 'Employer' : 'Job Seeker' %>
        <% if (user.headline) { %> · <%= user.headline %><% } %>
        <% if (user.company) { %> · <%= user.company %><% } %>
      </div>
      <a href="/profile/<%= user._id %>" class="btn btn-outline btn-sm" style="margin-top:8px;">View public profile</a>
    </div>
  </div>

  <% if (info) { %><div class="success"><%= info %></div><% } %>
  <% if (error) { %><div class="error"><%= error %></div><% } %>

  <form action="/profile" method="POST" enctype="multipart/form-data" class="form-card" style="max-width:none;">
    <h2>Edit profile</h2>

    <div class="form-group">
      <label>Profile picture</label>
      <input type="file" name="avatar" accept="image/*" />
      <small style="color:var(--muted);">JPG / PNG / WEBP, max 3 MB.</small>
    </div>

    <div class="grid-2">
      <div class="form-group">
        <label>Full name</label>
        <input name="name" value="<%= user.name || '' %>" required />
      </div>
      <div class="form-group">
        <label>Email</label>
        <input value="<%= user.email %>" disabled />
      </div>
    </div>

    <div class="grid-2">
      <div class="form-group">
        <label>Headline / tagline</label>
        <input name="headline" value="<%= user.headline || '' %>"
               placeholder="<%= user.role==='employer' ? 'e.g. Hiring engineers in Berlin' : 'e.g. Senior React Developer' %>" />
      </div>
      <div class="form-group">
        <label>Location</label>
        <input name="location" value="<%= user.location || '' %>" />
      </div>
    </div>

    <div class="grid-2">
      <div class="form-group">
        <label>Phone</label>
        <input name="phone" value="<%= user.phone || '' %>" />
      </div>
      <div class="form-group">
        <label>Website</label>
        <input name="website" value="<%= user.website || '' %>" placeholder="https://…" />
      </div>
    </div>

    <div class="form-group">
      <label>About / bio</label>
      <textarea name="bio" rows="4"><%= user.bio || '' %></textarea>
    </div>

    <% if (user.role === 'employer') { %>
      <h3>Company details</h3>
      <div class="grid-2">
        <div class="form-group">
          <label>Company name</label>
          <input name="company" value="<%= user.company || '' %>" />
        </div>
        <div class="form-group">
          <label>Industry</label>
          <input name="industry" value="<%= user.industry || '' %>" />
        </div>
      </div>
      <div class="form-group">
        <label>Company size</label>
        <select name="companySize">
          <option value="">Select…</option>
          <% ['1-10','11-50','51-200','201-500','501-1000','1000+'].forEach(s => { %>
            <option value="<%= s %>" <%= user.companySize === s ? 'selected' : '' %>><%= s %> employees</option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>About the company</label>
        <textarea name="companyAbout" rows="4"><%= user.companyAbout || '' %></textarea>
      </div>
    <% } else { %>
      <h3>Skills & background</h3>
      <div class="form-group">
        <label>Skills (comma-separated)</label>
        <input name="skills" value="<%= (user.skills||[]).join(', ') %>" placeholder="React, Node.js, SQL" />
      </div>

      <h4>Experience</h4>
      <div id="expList">
        <% var experience = user.experience && user.experience.length ? user.experience : [{}]; %>
        <% experience.forEach(function(e){ %>
          <div class="repeat-row">
            <div class="grid-2">
              <input name="exp_title" placeholder="Title" value="<%= e.title || '' %>" />
              <input name="exp_company" placeholder="Company" value="<%= e.company || '' %>" />
            </div>
            <div class="grid-2">
              <input name="exp_from" placeholder="From (e.g. 2021)" value="<%= e.from || '' %>" />
              <input name="exp_to" placeholder="To (e.g. Present)" value="<%= e.to || '' %>" />
            </div>
            <textarea name="exp_desc" rows="2" placeholder="Description"><%= e.description || '' %></textarea>
          </div>
        <% }); %>
      </div>
      <button type="button" class="btn btn-outline btn-sm" onclick="addExp()">+ Add experience</button>

      <h4 style="margin-top:18px;">Education</h4>
      <div id="eduList">
        <% var education = user.education && user.education.length ? user.education : [{}]; %>
        <% education.forEach(function(e){ %>
          <div class="repeat-row">
            <div class="grid-2">
              <input name="edu_school" placeholder="School / University" value="<%= e.school || '' %>" />
              <input name="edu_degree" placeholder="Degree" value="<%= e.degree || '' %>" />
            </div>
            <div class="grid-2">
              <input name="edu_field" placeholder="Field of study" value="<%= e.field || '' %>" />
              <input name="edu_year" placeholder="Year" value="<%= e.year || '' %>" />
            </div>
          </div>
        <% }); %>
      </div>
      <button type="button" class="btn btn-outline btn-sm" onclick="addEdu()">+ Add education</button>
    <% } %>

    <button class="btn" type="submit" style="margin-top:16px;width:100%;">Save profile</button>
  </form>
</div>

<script>
  function cloneFirst(listId) {
    var list = document.getElementById(listId);
    var first = list.querySelector('.repeat-row');
    var copy = first.cloneNode(true);
    copy.querySelectorAll('input, textarea').forEach(function(el){ el.value = ''; });
    list.appendChild(copy);
  }
  function addExp(){ cloneFirst('expList'); }
  function addEdu(){ cloneFirst('eduList'); }
</script>

<%- include('partials/footer') %>
